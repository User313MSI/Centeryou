# URL publique du site en production (métadonnées SEO : Open Graph, canonical, sitemap).
# Défaut si absente : https://centeryou.vercel.app — à remplacer par ton domaine Vercel.
# NEXT_PUBLIC_SITE_URL=https://centeryou.vercel.app

# Centeryou fonctionne SANS aucune clé API (Web Speech API par défaut).
# ElevenLabs est OPTIONNEL : renseigne ta clé ci-dessous pour une voix de synthèse
# premium (voix française féminine douce). En cas d'absence de clé ou d'échec,
# l'application bascule automatiquement sur le moteur par défaut, sans erreur.
# NEXT_PUBLIC_ELEVENLABS_API_KEY=ta-cle-elevenlabs-ici

# Optionnel : identifiant de voix ElevenLabs (laisser vide = voix FR féminine par défaut)
# NEXT_PUBLIC_ELEVENLABS_VOICE_ID=
