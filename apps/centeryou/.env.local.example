# ============================================================
# Centeryou — variables d'environnement (exemple)
# Copie ce fichier en .env.local pour le dev local.
# Sur Vercel : Project > Settings > Environment Variables.
# Règle d'or : aucune clé côté client (jamais de préfixe NEXT_PUBLIC_ sur une clé).
# ============================================================

# --- Voix premium ElevenLabs (Sarah) : SERVEUR uniquement ---
# Lue exclusivement par la route API /api/voix (src/app/api/voix/route.ts),
# jamais envoyée au navigateur. Vide = voix du navigateur (gratuite).
# NEXT_ELEVENLABS_API_KEY=ta-cle-elevenlabs-ici
# Optionnel : identifiant de voix (vide = Sarah, EXAVITQu4vr4xnSDxMaL)
# NEXT_ELEVENLABS_VOICE_ID=

# ── Supabase (OPTIONNEL) : comptes + sauvegarde en ligne ──────────
# Sans ces 2 variables, Centeryou reste 100 % local (mode anonyme inchangé).
# Mode d'emploi pas à pas : docs/INSTALL-SUPABASE.md
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Paiement Stripe (OBLIGATOIRE pour vendre Premium) ---
# Dashboard Stripe > Developers > API keys > "Secret key" (mode test d'abord : sk_test_...)
STRIPE_SECRET_KEY=
# Webhook : Stripe CLI en local (stripe listen --forward-to localhost:3000/api/stripe/webhook)
# ou dashboard Stripe > Developers > Webhooks > "Signing secret" (whsec_...) en prod
STRIPE_WEBHOOK_SECRET=
# OPTIONNEL : Price créé dans le dashboard Stripe (Products). Si vide, le prix est
# construit à la volée depuis src/lib/plans.ts (offre Premium, 4,99 €/mois, EUR).
STRIPE_PRICE_ID_PREMIUM=
# URL publique de l'app (retours Checkout / portail), ex. https://centeryou.vercel.app
# (en local, défaut = http://localhost:3000)
APP_URL=

# --- Synchronisation multi-appareils (offre Premium), OPTIONNEL ---
# Vercel KV (Storage > KV > Connect) : la synchro devient persistante entre appareils.
# Sans ces variables, repli en mémoire (fonctionne en local, non durable en prod).
KV_REST_API_URL=
KV_REST_API_TOKEN=
