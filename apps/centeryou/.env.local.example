# ============================================================
# Centeryou — variables d'environnement (exemple)
# Copie ce fichier en .env.local pour le dev local.
# Sur Vercel : colle chaque valeur dans Project > Settings > Environment Variables.
# ============================================================

# --- Paiement Stripe (OBLIGATOIRE pour vendre Premium) ---
# Tableau de bord Stripe > Developers > API keys > "Secret key" (mode test d'abord : sk_test_...)
STRIPE_SECRET_KEY=
# Webhook : Stripe CLI en local (stripe listen --forward-to localhost:3000/api/stripe/webhook)
# ou endpoint du dashboard Stripe en prod > Developers > Webhooks > "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=
# OPTIONNEL : Price créé dans le dashboard Stripe (Products). Si vide, le prix est
# construit à la volée depuis src/lib/plans.ts (offre Premium, 4,99 €/mois, EUR).
STRIPE_PRICE_ID_PREMIUM=
# URL publique de l'app (retours Checkout / portail), ex. https://centeryou.vercel.app
# (en local, défaut = http://localhost:3000)
APP_URL=

# --- Voix premium (ElevenLabs), servie par le serveur uniquement ---
# AUCUNE clé côté client : la voix premium passe par la route /api/voice/speak.
# Clé secrète ElevenLabs (dashboard.elevenlabs.io > API keys). Vide = voix du navigateur.
ELEVENLABS_API_KEY=
# Optionnel : identifiant de voix (défaut = voix FR féminine douce)
ELEVENLABS_VOICE_ID=

# --- Synchronisation multi-appareils (Premium), OPTIONNEL ---
# Vercel KV (Storage > KV > Connect) : la synchro devient persistante entre appareils.
# Sans ces variables, repli en mémoire (fonctionne en local, non durable en prod).
KV_REST_API_URL=
KV_REST_API_TOKEN=
