{
  "name": "centeryou-desktop",
  "productName": "Centeryou",
  "version": "1.0.0",
  "private": true,
  "description": "Centeryou — ton planning, ta voix : agenda, tâches et assistant vocal en français. Application bureau Windows (Electron) chargeant la version en ligne sur Vercel, avec repli hors-ligne sur la PWA.",
  "main": "main.js",
  "author": "Origine",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "check-build": "node scripts/check-build.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run icons && npm run check-build && electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.centeryou.app",
    "productName": "Centeryou",
    "copyright": "© 2026 Origine",
    "publisherName": "Origine",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "assets/**",
      "build-info.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Origine",
      "artifactName": "Centeryou-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerLanguages": [
        "fr"
      ],
      "displayLanguageSelector": false,
      "unicode": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": "always",
      "shortcutName": "Centeryou",
      "menuCategory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
