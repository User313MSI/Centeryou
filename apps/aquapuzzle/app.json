{
  "expo": {
    "name": "Aqua Puzzle",
    "slug": "aquapuzzle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a2540",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a2540"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novaloom.aquapuzzle"
    },
    "android": {
      "package": "com.novaloom.aquapuzzle",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a2540"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
