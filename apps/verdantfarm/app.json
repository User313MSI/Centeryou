      "backgroundColor": "#a8d78a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novaloom.verdantfarm"
    },
    "android": {
      "package": "com.novaloom.verdantfarm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a8d78a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
